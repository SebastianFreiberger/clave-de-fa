generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  sales        Sale[]
}

enum Currency {
  ARS
  USD
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  tagline    String
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?     @relation(fields: [brandId], references: [id])
  costPrice  Int        @default(0)
  price      Int
  currency   Currency   @default(ARS)
  stock      Int        @default(0)
  imageUrl   String?
  published  Boolean    @default(true)
  featured   Boolean    @default(false)
  order      Int        @default(0)
  saleItems  SaleItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

enum PaymentMethod {
  efectivo
  tarjeta
  transferencia
  otro
}

model Sale {
  id            String        @id @default(cuid())
  total         Int
  paymentMethod PaymentMethod @default(efectivo)
  notes         String?
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])
  items         SaleItem[]
  transaction   Transaction?
  createdAt     DateTime      @default(now())
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
  subtotal  Int
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    String
  amount      Int
  description String
  date        DateTime        @default(now())
  saleId      String?         @unique
  sale        Sale?           @relation(fields: [saleId], references: [id])
  createdAt   DateTime        @default(now())
}

enum ClassLevel {
  Iniciacion
  Intermedio
  Avanzado
}

enum ClassModality {
  Individual
  Grupal
}

model MusicClass {
  id         String        @id @default(cuid())
  slug       String        @unique
  instrument String
  level      ClassLevel
  modality   ClassModality
  teacher    String
  schedule   String
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

enum GalleryCategory {
  cuerdas
  vientos
  percusion
  audio
  academia
}

enum GallerySize {
  small
  medium
  large
}

model GalleryItem {
  id        String          @id @default(cuid())
  slug      String          @unique
  caption   String
  category  GalleryCategory
  size      GallerySize     @default(small)
  imageUrl  String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  quote     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessHour {
  id            String      @id @default(cuid())
  contactInfo   ContactInfo @relation(fields: [contactInfoId], references: [id], onDelete: Cascade)
  contactInfoId String
  day           String
  hours         String
  order         Int         @default(0)
}

model ContactInfo {
  id        String         @id @default(cuid())
  address   String
  city      String
  phone     String
  whatsapp  String
  email     String
  instagram String
  hours     BusinessHour[]
  updatedAt DateTime       @updatedAt
}
